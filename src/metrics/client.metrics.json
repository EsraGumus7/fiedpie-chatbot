    },
    {
      "metric_id": "distributor_by_group",
      "intent": "distributorsByGroup",
      "description_tr": "Gruba gore distributor dagilimi",
      "source_tables": [
        "dbo.DistributorNetworkEntity",
        "dbo.DistributorGroup"
      ],
      "aggregation": "count_group_by",
      "default_filters": [
        "Deleted = 0"
      ],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_by_type",
      "intent": "distributorsByType",
      "description_tr": "Tipine gore distributor dagilimi",
      "source_tables": [
        "dbo.DistributorNetworkEntity"
      ],
      "aggregation": "count_group_by",
      "default_filters": [
        "Deleted = 0"
      ],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_by_status",
      "intent": "distributorsByStatus",
      "description_tr": "Duruma gore distributor dagilimi",
      "source_tables": [
        "dbo.DistributorNetworkEntity"
      ],
      "aggregation": "count_group_by",
      "default_filters": [
        "Deleted = 0"
      ],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_experience_stores",
      "intent": "distributorsExperienceStores",
      "description_tr": "Deneyim magazasi olan distributorler",
      "source_tables": [
        "dbo.DistributorNetworkEntity",
        "dbo.DistributorAdditionalInfo"
      ],
      "aggregation": "count",
      "default_filters": [
        "dbo.DistributorAdditionalInfo.IsExperienceStore = 1",
        "Deleted = 0"
      ],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_daily_trend",
