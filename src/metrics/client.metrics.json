      ],
      "aggregation": "count_group_by",
      "default_filters": [
        "Deleted = 0"
      ],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "consumer_daily_trend",
      "intent": "consumerTrend",
      "description_tr": "Gunluk tuketici kazanim trendi",
      "source_tables": [
        "dbo.Consumer"
      ],
      "aggregation": "count_group_by_date",
      "default_filters": [
        "Deleted = 0"
      ],
      "security_scope": "tenant_user_scope"
    },
