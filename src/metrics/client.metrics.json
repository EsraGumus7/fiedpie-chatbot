{
  "domain": "musteri_bilgileri",
  "version": "1.0.3",
  "metrics": [
    {
      "metric_id": "client_count_active",
      "intent": "clientCountActive",
      "description_tr": "Aktif musteri toplam sayisi",
      "source_tables": ["dbo.Client"],
      "aggregation": "count",
      "default_filters": ["Client.Passive = 0", "Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_count_total",
      "intent": "clientCountTotal",
      "description_tr": "Toplam musteri sayisi",
      "source_tables": ["dbo.Client"],
      "aggregation": "count",
      "default_filters": ["Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_count_passive",
      "intent": "clientCountPassive",
      "description_tr": "Pasif musteri toplam sayisi",
      "source_tables": ["dbo.Client"],
      "aggregation": "count",
      "default_filters": ["Client.Passive = 1", "Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_count_archived",
      "intent": "clientCountArchived",
      "description_tr": "Arsivlenmis musteri sayisi",
      "source_tables": ["dbo.Client"],
      "aggregation": "count",
      "default_filters": ["Client.Archived = 1", "Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_by_group",
      "intent": "clientsByGroup",
      "description_tr": "Gruba gore musteri dagilimi",
      "source_tables": ["dbo.Client", "dbo.ClientGroup"],
      "aggregation": "count_group_by",
      "default_filters": ["Client.Deleted = 0", "ClientGroup.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_by_state",
      "intent": "clientsByState",
      "description_tr": "Duruma gore musteri dagilimi",
      "source_tables": ["dbo.Client", "dbo.ClientState"],
      "aggregation": "count_group_by",
      "default_filters": ["Client.Deleted = 0", "ClientState.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_by_country",
      "intent": "clientsByCountry",
      "description_tr": "Ulkeye gore musteri dagilimi",
      "source_tables": ["dbo.Client", "dbo.Country"],
      "aggregation": "count_group_by",
      "default_filters": ["Client.Deleted = 0", "Country.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_by_program_type",
      "intent": "clientsByProgramType",
      "description_tr": "Program tipine gore musteri dagilimi",
      "source_tables": ["dbo.Client", "dbo.ProgramType"],
      "aggregation": "count_group_by",
      "default_filters": ["Client.Deleted = 0", "ProgramType.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_deal_amount_total",
      "intent": "totalClientDealAmount",
      "description_tr": "Toplam musteri anlasma tutari",
      "source_tables": ["dbo.Client"],
      "aggregation": "sum",
      "default_filters": ["Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_daily_trend",
      "intent": "clientTrend",
      "description_tr": "Gunluk musteri kazanim trendi",
      "source_tables": ["dbo.Client"],
      "aggregation": "count_group_by_date",
      "default_filters": ["Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_count_total",
      "intent": "totalDistributors",
      "description_tr": "Toplam distributor sayisi",
      "source_tables": ["dbo.DistributorNetworkEntity"],
      "aggregation": "count",
      "default_filters": ["DistributorNetworkEntity.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_by_region",
      "intent": "distributorsByRegion",
      "description_tr": "Bolgeye gore distributor dagilimi",
      "source_tables": ["dbo.DistributorNetworkEntity", "dbo.Region"],
      "aggregation": "count_group_by",
      "default_filters": ["DistributorNetworkEntity.Deleted = 0", "Region.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_by_group",
      "intent": "distributorsByGroup",
      "description_tr": "Gruba gore distributor dagilimi",
      "source_tables": ["dbo.DistributorNetworkEntity", "dbo.DistributorGroup"],
      "aggregation": "count_group_by",
      "default_filters": ["DistributorNetworkEntity.Deleted = 0", "DistributorGroup.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_by_type",
      "intent": "distributorsByType",
      "description_tr": "Tipine gore distributor dagilimi",
      "source_tables": ["dbo.DistributorNetworkEntity"],
      "aggregation": "count_group_by",
      "default_filters": ["DistributorNetworkEntity.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_by_status",
      "intent": "distributorsByStatus",
      "description_tr": "Duruma gore distributor dagilimi",
      "source_tables": ["dbo.DistributorNetworkEntity"],
      "aggregation": "count_group_by",
      "default_filters": ["DistributorNetworkEntity.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_experience_stores",
      "intent": "distributorsExperienceStores",
      "description_tr": "Deneyim magazasi olan distributorler",
      "source_tables": ["dbo.DistributorNetworkEntity", "dbo.DistributorAdditionalInfo"],
      "aggregation": "count",
      "default_filters": [
        "DistributorNetworkEntity.Deleted = 0",
        "DistributorAdditionalInfo.Deleted = 0",
        "DistributorAdditionalInfo.IsExperienceStore = 1"
      ],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "distributor_daily_trend",
      "intent": "distributorTrend",
      "description_tr": "Gunluk distributor eklenme trendi",
      "source_tables": ["dbo.DistributorNetworkEntity"],
      "aggregation": "count_group_by_date",
      "default_filters": ["DistributorNetworkEntity.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "consumer_count_total",
      "intent": "consumerCountTotal",
      "description_tr": "Toplam tuketici sayisi",
      "source_tables": ["dbo.Consumer"],
      "aggregation": "count",
      "default_filters": ["Consumer.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "consumer_by_segment",
      "intent": "consumersBySegment",
      "description_tr": "Segmente gore tuketici dagilimi",
      "source_tables": ["dbo.Consumer", "dbo.ConsumerSegment"],
      "aggregation": "count_group_by",
      "default_filters": ["Consumer.Deleted = 0", "ConsumerSegment.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "consumer_daily_trend",
      "intent": "consumerTrend",
      "description_tr": "Gunluk tuketici kazanim trendi",
      "source_tables": ["dbo.Consumer"],
      "aggregation": "count_group_by_date",
      "default_filters": ["Consumer.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "data_change_count_total",
      "intent": "totalDataChanges",
      "description_tr": "Toplam musteri veri degisikligi talebi",
      "source_tables": ["dbo.ClientDataChange"],
      "aggregation": "count",
      "default_filters": ["ClientDataChange.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "data_change_by_type",
      "intent": "dataChangesByType",
      "description_tr": "Tipe gore musteri veri degisiklikleri",
      "source_tables": ["dbo.ClientDataChange"],
      "aggregation": "count_group_by",
      "default_filters": ["ClientDataChange.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "data_change_trend",
      "intent": "dataChangeTrend",
      "description_tr": "Gunluk musteri veri degisikligi talebi trendi",
      "source_tables": ["dbo.ClientDataChange"],
      "aggregation": "count_group_by_date",
      "default_filters": ["ClientDataChange.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_info_update_count",
      "intent": "totalClientInfoUpdates",
      "description_tr": "Toplam musteri bilgisi guncelleme sayisi",
      "source_tables": ["dbo.ClientInfoUpdate"],
      "aggregation": "count",
      "default_filters": ["ClientInfoUpdate.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "rni_device_count",
      "intent": "totalRniDevices",
      "description_tr": "Sistemdeki toplam RNI donanim sayisi",
      "source_tables": ["dbo.RNI"],
      "aggregation": "count",
      "default_filters": ["RNI.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_file_count",
      "intent": "totalClientFiles",
      "description_tr": "Sisteme yuklenmis toplam musteri dosyasi",
      "source_tables": ["dbo.ClientFile"],
      "aggregation": "count",
      "default_filters": ["ClientFile.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    },
    {
      "metric_id": "client_by_city",
      "intent": "clientsByCity",
      "description_tr": "Sehre gore musteri dagilimi",
      "source_tables": ["dbo.Client"],
      "aggregation": "count_group_by",
      "default_filters": ["Client.Deleted = 0"],
      "security_scope": "tenant_user_scope"
    }
  ]
}
