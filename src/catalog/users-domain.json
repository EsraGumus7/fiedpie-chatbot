  "business_glossary_tr": [
    {
      "term": "Aktif kullanıcı",
      "maps_to": "dbo.User.Deleted = 0 AND dbo.User.Blocked = 0 AND dbo.User.DeleteRequest = 0"
    },
    {
      "term": "Bloke kullanıcı",
      "maps_to": "dbo.User.Deleted = 0 AND dbo.User.Blocked = 1"
    },
